rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "monzerbassamalabdullah@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'city', 'requestType', 'createdAt'])
        && data.keys().hasOnly(['name', 'city', 'requestType', 'createdAt', 'details'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
        && data.requestType is string && data.requestType.size() >= 2 && data.requestType.size() <= 100
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && data.createdAt == request.time;
    }

    match /inquiries/{inquiryId} {
      // Public submissions allowed with strict schema validation
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      // Admin read & management
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
